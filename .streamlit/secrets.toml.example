# 이 파일을 복사해서 같은 폴더에 secrets.toml을 만들고 진짜 값을 넣으세요.
# secrets.toml은 GitHub에 올라가지 않습니다.
# 배포용 값은 Streamlit Cloud > App settings > Secrets에 같은 내용을 붙여 넣습니다.
#
# ⚠️ TOML 규칙: [connections.supabase] 같은 [묶음] 아래에 쓴 줄은 전부 그 묶음에 들어갑니다.
#    그래서 API 키는 반드시 맨 아래 [connections.supabase]보다 위, 내 모듈 칸 아래에 추가합니다.

# ===== 공통 (PM) =====
AI_API_KEY = "your_ai_api_key_here"
WEATHER_API_KEY = "your_weather_api_key_here"

# ===== home =====

# ===== report =====

# ===== hypothesis =====

# ===== media =====

# ===== solution =====

# ===== weather =====

# ===== Supabase (PM, 맨 아래 고정) =====
[connections.supabase]
SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_KEY = "your_supabase_anon_key_here"
