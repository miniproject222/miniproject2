# 비밀값 양식 (PM) - 이 파일은 GitHub에 올라갑니다. 진짜 값은 절대 여기에 쓰지 않습니다.
# 쓰는 법: 이 파일을 복사해 같은 폴더에 secrets.toml 로 이름을 바꾸고, "..." 자리에 PM에게 따로 받은 값을 넣습니다.
#          secrets.toml은 .gitignore에 있어 GitHub에 올라가지 않습니다. 값을 넣은 뒤에는 앱을 껐다 다시 켭니다.
# 주의: 맨 위 키들은 반드시 [connections.supabase] 줄보다 위에 둡니다.
#       아래로 내려가면 Supabase 설정의 일부로 읽혀서 앱이 키를 못 찾습니다.

# ③ 매체 제작: 사진·스토리보드·번역 (OpenAI)
OPENAI_API_KEY = "..."

# ③ 매체 제작: 영상 Higgsfield API 잔액용 (없으면 이 줄을 지워도 됨. 구독 크레딧은 앱 안 'Higgsfield 로그인'으로)
HF_KEY = "..."

# ① 문제 분석: Keepa 경쟁사 조회 (없으면 조회 버튼만 꺼짐)
KEEPA_API_KEY = "..."
KEEPA_FETCH_PIN = "..."
KEEPA_AUTO_DAILY = "off"  # "on"이면 매일 아침(한국 08:00 이후 첫 접속) Keepa 경쟁사 자동 조회 (약 6토큰)

# 팀 공용 데이터 창고 (모든 탭이 단계 사이 값을 여기에 저장 · 없으면 홈 등이 샘플 화면으로 보임)
# 키는 sb_publishable_ 로 시작하는 것만 씁니다. service_role / sb_secret_ 키는 절대 쓰지 않습니다.
[connections.supabase]
SUPABASE_URL = "https://twnhvfwsuawvhplahibd.supabase.co"
SUPABASE_KEY = "sb_publishable_..."
